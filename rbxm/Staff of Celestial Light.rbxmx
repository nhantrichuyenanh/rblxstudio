		<Item class="LocalScript" referent="RBX9D73FCDB7FF04BFF8839169D303D1852">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Local Gui</string>
				<string name="ScriptGuid">{ED91E924-E743-4F75-868A-C63F26B17851}</string>
				<ProtectedString name="Source"><![CDATA[Tool = script.Parent

local stillEquipped = false

function onEquippedLocal(mouse)
	stillEquipped = true
	if mouse == nil then 
		print("Mouse not found")
		return
	end
	while stillEquipped do
		print("Setting Mouse to go")
		mouse.Icon = "rbxasset://textures\\GunCursor.png"
		while Tool.Enabled and stillEquipped do 
			wait(0.01)
		end
		print("Setting Mouse to wait")
		mouse.Icon = "rbxasset://textures\\GunWaitCursor.png"
		while not Tool.Enabled and stillEquipped do 
			wait(0.01)
		end
	end
end

function onUnequippedLocal()
	stillEquipped = false
end

Tool.Equipped:connect(onEquippedLocal)
Tool.Unequipped:connect(onUnequippedLocal)

]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX10CD0CE76D734EFE822557D500166FF7">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">StaffScript</string>
				<string name="ScriptGuid">{FFA3CF56-45A3-4E35-8386-32C6CC70F718}</string>
				<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Staff = Tool.Handle

local vCharacter 
local numChar = 0

Tool.Enabled = true
local staffSound 

local staffAOE = Vector3.new(20.0, 20.0, 20.0)

local healField = Instance.new("Part")
healField.Name = "Field"
healField.Size = Vector3.new(1, 1, 1)
healField.Transparency = 0.8


local fieldMesh = Instance.new("SpecialMesh")
fieldMesh.MeshType = "FileMesh"
fieldMesh.Name = "Mesh"
fieldMesh.MeshId = "http://www.roblox.com/asset/?id=48423624"
fieldMesh.TextureId = "http://www.roblox.com/asset/?id=49457234"
fieldMesh.Scale = Vector3.new(0.2, 0.2, 0.2)
fieldMesh.Parent = healField

function onActivated()

	if Tool.Enabled == false then 
		return
	end

	Tool.Enabled = false

	vCharacter = Tool.Parent
	myTorso = vCharacter:FindFirstChild("Torso")

	if myTorso == nil then 
		return
	end

	myHumanoid = vCharacter:FindFirstChild("Humanoid")
	if myHumanoid == nil then
		return
	end

	staffSound = Tool:FindFirstChild("StaffSound")
	if staffSound then staffSound:Play() end

	parts = game.Workspace:FindPartsInRegion3(Region3.new(myTorso.Position - staffAOE, myTorso.Position + staffAOE), vCharacter, 100)
	
	for i = 1, #parts do 
		tempChar = parts[i].Parent
		tempHumanoid = tempChar:FindFirstChild("Humanoid")
		if tempHumanoid ~= nil then 
			healing = tempHumanoid:FindFirstChild("Healing")
			if healing == nil then 
				healing = Instance.new("StringValue")
				healing.Name = "Healing"
				healing.Parent = tempHumanoid
				healing.Value = "Healing"
				
				newScript = Tool.LightInsertScript:Clone()
				newScript.Parent = tempChar
				newScript.Disabled = false
				numChar = numChar + 1
	
				field = healField:Clone()
				field.Parent = tempChar.Torso

				fieldWeld = Instance.new("Weld")
				fieldWeld.Part0 = tempChar.Torso
				fieldWeld.Part1 = field
				fieldWeld.Parent = tempChar.Torso				
			end
		end
	end

	charScript = vCharacter:FindFirstChild("CharScript")
	if numChar > 0 and charScript == nil then 

		field = healField:Clone()
		field.Parent = vCharacter	

		fieldWeld = Instance.new("Weld")
		fieldWeld.Part0 = myTorso
		fieldWeld.Part1 = field
		fieldWeld.Parent = myTorso
		fieldWeld.Name = "FieldWeld"

		buff = Instance.new("StringValue")
		buff.Name = "Buff"
		buff.Parent = myHumanoid
		buff.Value = "Buff"	

		newScript = Tool.CharScript:Clone()
		newScript.Parent = vCharacter

		nChar = newScript.NumChar
		nChar.Value = numChar
		newScript.Disabled = false	
	
	end

	wait(8.0)
	Tool.Enabled = true
	numChar = 0
end

function onEquipped()
end

function onUnequipped()
	if staffSound then staffSound:Stop() end
end

Tool.Activated:connect(onActivated)
Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)
]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
		<Item class="LocalScript" referent="RBX9EFD54B19602400A8B514AD25BCEB8ED">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">AnimateScript</string>
				<string name="ScriptGuid">{050EAFF4-EAB2-419C-98FB-179FDCB8B2B5}</string>
				<ProtectedString name="Source"><![CDATA[local Tool = script.Parent

-- Animations
local staffAnim

function onActivatedL()
	vCharacter = Tool.Parent

	myHumanoid = vCharacter:FindFirstChild("Humanoid")
	if myHumanoid == nil then 
		return
	end
	
	if Tool.Enabled then
		staffAnim = myHumanoid:LoadAnimation(Tool.LightStaffAnim)
		staffAnim:Play()	
	end
end

function onEquippedL()
end

function onUnequippedL()
	if staffAnim then staffAnim:Stop() end	
end

Tool.Activated:connect(onActivatedL)
Tool.Equipped:connect(onEquippedL)
Tool.Unequipped:connect(onUnequippedL)]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBXC08AD2D627EB4598A8B6F49C675CE24E">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LightInsertScript</string>
				<string name="ScriptGuid">{B5B4E79A-40EC-4F10-88CF-E1A510D3CB72}</string>
				<ProtectedString name="Source"><![CDATA[vChar = script.Parent
humanoid = vChar:FindFirstChild("Humanoid")
local co 
healing = humanoid:FindFirstChild("Healing")


local sign = -0.2


function reset()
	wait(10.0)
	if humanoid.Health > 70 then humanoid.Health = humanoid.Health - 50 end
	if humanoid.MaxHealth > 100 then humanoid.MaxHealth = 100 end
	healed = humanoid:FindFirstChild("Healing")
	if healed then healed:Remove() end
	field = vChar.Torso:FindFirstChild("Field")	
	if field then field:Remove() end
	script:Remove()
end


if humanoid ~= nil then 
	if humanoid.MaxHealth == 100 and humanoid.Health <= humanoid.MaxHealth then 
		humanoid.MaxHealth = 150 
		humanoid.Health = humanoid.Health + 50
		co = coroutine.create(reset)
		coroutine.resume(co)
	end
end
	
while healing do 	
	field = vChar.Torso:FindFirstChild("Field")	
	while field == nil do wait(1.0) field = vChar.Torso:FindFirstChild("Field") end	
	field.Transparency = field.Transparency + sign
	sign = sign * -1
	wait(1.0)
end]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBXEA69A7BA20BF42C3BC8C47A5076CEC00">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">CharScript</string>
				<string name="ScriptGuid">{2EF1FA8B-5054-42F2-99D2-6D4B5893A039}</string>
				<ProtectedString name="Source"><![CDATA[local vChar = script.Parent
local torso = vChar.Torso
buff = vChar.Humanoid:FindFirstChild("Buff")
numChar = script.NumChar

buffDuration = 35 -- Number of seconds the buff should last

sign = -0.2
local co

humanoid = vChar:FindFirstChild("Humanoid")

if humanoid ~= nil then 	
	maximumHealth = humanoid.MaxHealth + numChar.Value * 40
	if maximumHealth < 800 and humanoid.Health <= humanoid.MaxHealth then 		
		percentage = humanoid.Health/humanoid.MaxHealth			
		humanoid.MaxHealth = (humanoid.MaxHealth * 1.5) + numChar.Value * 40
		humanoid.Health = percentage * humanoid.MaxHealth
	else 
		percentage = humanoid.Health/humanoid.MaxHealth	
		humanoid.MaxHealth = 800
		humanoid.Health = humanoid.MaxHealth * percentage
	end	
	
end



while buff do 

field = vChar:FindFirstChild("Field") 
while field == nil do wait(1.0) field  = vChar:FindFirstChild("Field") buffDuration = buffDuration - 1 end
 
if buffDuration  < 7 then	
	field.Transparency = field.Transparency + sign
	sign = sign * -1
end

if buffDuration <= 0 then 	
	percentage = humanoid.Health/humanoid.MaxHealth 
	humanoid.MaxHealth = 100
	humanoid.Health = percentage * humanoid.MaxHealth
	if field then field:Remove() end	
	if buff then buff:Remove() end	
	buffDuration = 35
	script:Remove()	
end

buffDuration = buffDuration - 1
wait(1.0)
end

]]></ProtectedString>
