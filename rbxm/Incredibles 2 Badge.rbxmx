		<Item class="Script" referent="RBXEF0761B2502843D5A420C69455008136">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="ScriptGuid">{3EC65905-0CC2-48E4-BF70-2A0A6A60477A}</string>
				<ProtectedString name="Source"><![CDATA[-- // Created by StarWars
local tool = script.Parent

local character
local humanoid
local cacheWalkspeed = 16

tool.Equipped:Connect(function()
	character = tool.Parent
	humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		cacheWalkspeed = humanoid.WalkSpeed
		humanoid.WalkSpeed = 24 
	end
end)

tool.Unequipped:Connect(function()
	if humanoid then
		humanoid.WalkSpeed = cacheWalkspeed
	end
end)]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
