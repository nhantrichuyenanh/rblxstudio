		<Item class="LocalScript" referent="RBXEE9AA4064F214626A01BBABC7D4B4517">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Local Gui</string>
				<string name="ScriptGuid">{CFF9B380-2827-4B2E-9A61-E7D1973B6D19}</string>
				<ProtectedString name="Source"><![CDATA[local Tool = script.Parent;

local keepLooping = true

function onEquippedLocal(mouse)

	keepLooping = true

	if mouse == nil then
		print("Mouse not found")
		return 
	end

	mouse.Icon = "rbxasset://textures\\GunCursor.png"

	while keepLooping do
		while Tool.Enabled do
			if not keepLooping then return end
			wait(.01)
		end
		
		print("Setting Mouse To Wait")
		mouse.Icon = "rbxasset://textures\\GunWaitCursor.png"

		while not Tool.Enabled do
			if not keepLooping then return end
			wait(.01)
		end

		print("Setting Mouse To Go")
		mouse.Icon = "rbxasset://textures\\GunCursor.png"
	end

	keepLooping = true
end

function onUnequippedLocal()
	keepLooping = false
end


Tool.Equipped:connect(onEquippedLocal)
Tool.Unequipped:connect(onUnequippedLocal)
]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
