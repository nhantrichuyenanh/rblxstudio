		<Item class="Script" referent="RBX0485F3C7455748DC9DE4179ED486C746">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="ScriptGuid">{EC2A916B-9146-4D66-84C9-03C77EC78CEF}</string>
				<ProtectedString name="Source"><![CDATA[-- // Created by StarWars
local InsertService = game:GetService("InsertService")

local GearService = require(1075123174)

local tool = script.Parent
local gear = GearService:BindGear(tool, "Mount")

local babyNessie = InsertService:LoadAsset(2431256078)
babyNessie = babyNessie:GetChildren()[1]

gear.Class:SetMountModel(babyNessie)]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
