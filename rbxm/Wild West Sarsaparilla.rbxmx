		<Item class="Script" referent="RBXC67F550BB57842949670E48B585CE40A">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">SpeedScript</string>
				<string name="ScriptGuid">{1B7B2346-DE54-420A-BFF5-FCF7F20A1B81}</string>
				<ProtectedString name="Source"><![CDATA[local myCharacter = script.Parent
local myHumanoid = myCharacter:FindFirstChildOfClass("Humanoid")
local Torso = myCharacter:FindFirstChild("Torso") or myCharacter:FindFirstChild("UpperTorso")
if not myHumanoid or not Torso then script:Destroy() end

local DEFAULT_SPEED = 16

local Sparkles = Instance.new("Sparkles")
Sparkles.Name = "Sarsaparilla Sparkles"
Sparkles.SparkleColor = Color3.new(0, 1, 0)
Sparkles.Parent = Torso

for i = 1, 20 do
	myHumanoid.WalkSpeed = DEFAULT_SPEED + 2 * (20 - i)
	Sparkles.SparkleColor = Color3.new(i/20, (20 - i)/20, 0)
	wait(1)
end

myHumanoid.WalkSpeed = DEFAULT_SPEED	-- Just to check.

if Sparkles then Sparkles:Destroy() end
script:Destroy()
]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX779B579A655E434AB54C6FEF25BAC580">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">ChangeEnabled</string>
				<string name="ScriptGuid">{EB27D783-6B9F-4C9B-80A2-0E7B90C62E2E}</string>
				<ProtectedString name="Source"><![CDATA[local Tool = script.Parent

wait(20)

Tool.Enabled = true
script:Destroy()
]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX9F689A0377464F19A7657651BF4FF87D">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Sarsaparilla</string>
				<string name="ScriptGuid">{956DEB25-6601-486F-B4C4-099A31A38A44}</string>
				<ProtectedString name="Source"><![CDATA[local Tool = script.Parent

local Handle = Tool:WaitForChild("Handle",10)

local DrinkAnim
local DrinkSound
local ScreamSound

local EnabledScript
local SpeedScript

local myCharacter
local myHumanoid

if not Tool:FindFirstChild("ChangeEnabledCopy") then
	Tool.Enabled = true
end

function onActivated()
	myCharacter = Tool.Parent
	if not myCharacter then return end
	myHumanoid = myCharacter:FindFirstChildOfClass("Humanoid")
	if not myHumanoid then return end

	if not Tool.Enabled then return end
	Tool.Enabled = false

	DrinkAnim = Tool:FindFirstChild("Drink"..myHumanoid.RigType.Name)
	if DrinkAnim then DrinkAnim = myHumanoid:LoadAnimation(DrinkAnim) end
	if DrinkAnim then DrinkAnim:Play() end

	wait(0.5)

	DrinkSound = Handle:FindFirstChild("DrinkSound")
	if DrinkSound then DrinkSound:Play() end
	
	wait(1)

	ScreamSound = Handle:FindFirstChild("Yeehaw")
	if ScreamSound then ScreamSound:Play() end

	wait(1.5)

	SpeedScript = Tool:FindFirstChild("SpeedScript")
	if SpeedScript then
		SpeedScript = SpeedScript:Clone()
		SpeedScript.Parent = myCharacter
		SpeedScript.Disabled = false
	end

	EnabledScript = Tool:FindFirstChild("ChangeEnabled")	-- Using a script to change the enabled/disabled-ness of the tool, to avoid problems
	if EnabledScript then											--   when tool is backspaced in the middle of use.
		EnabledScript = EnabledScript:Clone()
		EnabledScript.Name = "ChangeEnabledCopy"
		EnabledScript.Parent = Tool
		EnabledScript.Disabled = false
	end
end

function onUnequipped()
	if DrinkAnim then DrinkAnim:Stop() end
	if DrinkSound then DrinkSound:Stop() end
	if ScreamSound then ScreamSound:Stop() end
end

Tool.Activated:Connect(onActivated)
Tool.Unequipped:Connect(onUnequipped)]]></ProtectedString>
