				<string name="Name">ShockScript</string>
				<string name="ScriptGuid">{C4D83392-9151-4EF5-995B-AC7D16E0D31A}</string>
				<ProtectedString name="Source"><![CDATA[vChar = script.Parent
humanoid= vChar:FindFirstChild("Humanoid")

if humanoid then 
	humanoid.WalkSpeed = 2.0

	children = vChar:GetChildren()
	for i = 1, #children do 
		if children[i]:IsA("Tool") then 
			children[i].Parent = workspace
		end
	end	
end

wait(2.0)

humanoid.WalkSpeed = 16.0
script:Destroy() 
]]></ProtectedString>
