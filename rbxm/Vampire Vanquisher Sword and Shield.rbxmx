				<ProtectedString name="Source"><![CDATA[--Revamped by TakeoHonorable
--Now has the ability to actually vanquish all things vampire
-- + 33% dasmage resistance

function Create(ty)
	return function(data)
		local obj = Instance.new(ty)
		for k, v in pairs(data) do
			if type(k) == 'number' then
				v.Parent = obj
			else
				obj[k] = v
			end
		end
		return obj
	end
end

local Tool = script.Parent
Tool.Enabled = true

local Handle = Tool:WaitForChild("Handle")

local Effect = Handle:WaitForChild("Effects"):WaitForChild("Flare")
Effect.Enabled = true

local Remote = (Tool:FindFirstChildOfClass("RemoteEvent") or Create("RemoteEvent"){
	Name = "Remote",
	Parent = Tool
})

local Animations = {}

local Sounds = {
	Slash = Handle:WaitForChild("Slash"),
	Sprint = Handle:WaitForChild("Sprint"),
	SwordHit = Handle:WaitForChild("SwordHit"),
	Equip = Handle:WaitForChild("Equip"),
	CoffinStrike = Handle:WaitForChild("CoffinStrike")
}

local Services = {
	Players = (game:FindService("Players") or game:GetService("Players")),
	Debris = (game:FindService("Debris") or game:GetService("Debris")),
	ServerScriptService = (game:FindService("ServerScriptService") or game:GetService("ServerScriptService"))
}

local Player,Character,Humanoid

local Special = true

local Events = {}

local Deletables = {}

local function CreateArmWeld(Shield)
	--if ArmShieldWeld then return end
	if Character and (Character:FindFirstChild('Left Arm') or Character:FindFirstChild('LeftUpperArm')) then
		Events[#Events+1] = (Character:FindFirstChild('Left Arm') or Character:FindFirstChild('LeftUpperArm')).ChildRemoved:Connect(function(child) if Humanoid and Humanoid.Health ~= 0 and Tool.Parent == Character and child.Name == 'ArmWeld' then CreateArmWeld(Shield) end end)
		
		Deletables[#Deletables+1] = Create('Weld'){
			Name = "ArmWeld",
			Part0 = (Character:FindFirstChild('Left Arm') or Character:FindFirstChild('LeftUpperArm')),
			Part1 = Shield,
			C0 = CFrame.new() * CFrame.Angles(math.rad(-90), math.rad(90), 0),
			C1 = CFrame.new() + Vector3.new(0, 0, 0.6),
			Parent = (Character:FindFirstChild('Left Arm') or Character:FindFirstChild('LeftUpperArm'))
		}
		
		Shield.Parent = Tool
	else
		--print('CreateArmWeld: you have no character or no left arm.')
	end
end

function IsTeamMate(Player1, Player2)
	return (Player1 and Player2 and not Player1.Neutral and not Player2.Neutral and Player1.TeamColor == Player2.TeamColor)
end

function TagHumanoid(humanoid, player)
	local Creator_Tag = Instance.new("ObjectValue")
	Creator_Tag.Name = "creator"
	Creator_Tag.Value = player
	Services.Debris:AddItem(Creator_Tag, 2)
	Creator_Tag.Parent = humanoid
end

function UntagHumanoid(humanoid)
	for i, v in pairs(humanoid:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "creator" then
			v:Destroy()
		end
	end
end

local function HasFinisher(Hum) -- Quick check to see if they're not stunned
	local Children = Services.ServerScriptService:GetChildren()
	for i=1, #Children do
		if Children[i]:IsA("Script") and Children[i].Name == "Finisher" and Children[i]:FindFirstChild("Target") and Children[i]:FindFirstChild("Target").Value == Hum.Parent then
			return true
		end
	end
	return false
end

function Touched(hit)
	if not hit or not hit.Parent then return end
	local Hum,FF = hit.Parent:FindFirstChildOfClass("Humanoid"),hit.Parent:FindFirstChildOfClass("ForceField")
	if Hum and Hum ~= Humanoid and Hum.Health > 0 and not FF and not IsTeamMate(Player, Services.Players:GetPlayerFromCharacter(Hum.Parent)) then
		UntagHumanoid(Hum)
		TagHumanoid(Hum,Player)
		if (Hum.Health/Hum.MaxHealth)*100 <= 30 then
			if not HasFinisher(Hum)  then
				--Cue the finisher instead
				local Finisher = script:WaitForChild("Finisher"):Clone()
				Create("ObjectValue"){
					Name = "Target",
					Value = Hum.Parent,
					Parent = Finisher
				}
				Create("ObjectValue"){
					Name = "Creator",
					Value = Character,
					Parent = Finisher
				}
				Finisher.Parent = Services.ServerScriptService
				Finisher.Disabled = false
			end
		else
			UntagHumanoid(Hum)
			TagHumanoid(Hum,Player)
			Hum:TakeDamage(20)
			
		end 
	end
end


function Vanquish()
	Animations.ExecuteAnim:Play()
	delay(.5, function()
		local VanquishScript = script:WaitForChild("Vanquish"):Clone()
		VanquishScript.Parent = Services.ServerScriptService
		
		Create("Vector3Value"){
			Name = "Position",
			Value = (Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")).Position,
			Parent = VanquishScript
		}
		Create("ObjectValue"){
			Name = "Creator",
			Value = Player,
			Parent = VanquishScript
		}
		
		VanquishScript.Disabled = false
		Sounds.CoffinStrike:Play()
	end)
end

function Activated()
	if not Tool.Enabled then return end
	Tool.Enabled = false
	Sounds.Slash:Play()
	Animations.SwingAnim:Play(nil,nil,2)
	wait(.5)
	Tool.Enabled = true
end

function Equipped()
	Character = Tool.Parent
	Player = Services.Players:GetPlayerFromCharacter(Character)
	Humanoid = Character:FindFirstChildOfClass("Humanoid")
	
	if not Humanoid or Humanoid.Health <= 0 or not Character then return end
	
	Animations = Tool:WaitForChild("Animations")
	Animations = {
		EquipAnim = Humanoid:LoadAnimation(Animations:WaitForChild(Humanoid.RigType.Name):WaitForChild("EquipAnim")),
		ExecuteAnim = Humanoid:LoadAnimation(Animations:WaitForChild(Humanoid.RigType.Name):WaitForChild("ExecuteAnim")),
		IdleAnim = Humanoid:LoadAnimation(Animations:WaitForChild(Humanoid.RigType.Name):WaitForChild("IdleAnim")),
		SwingAnim = Humanoid:LoadAnimation(Animations:WaitForChild(Humanoid.RigType.Name):WaitForChild("SwingAnim"))
	}
	
	local Shield = Create("Part"){
		Size = Vector3.new(2.4, 5.2, 0.8)*(Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")).Size.Z,
		Massless = true,
		Locked = true,
		Parent = Tool
	}
	Create('SpecialMesh'){
		MeshId = 'http://www.roblox.com/asset/?id=94752182',
		TextureId = 'http://www.roblox.com/asset/?id=94752144',
		Scale = Vector3.new(2.3,2.3,2.3),
		Parent = Shield,
	}
	CreateArmWeld(Shield)
	Deletables[#Deletables+1] = Shield
	
	local IgnoreHealthChange = false
	local CurrentHealth = Humanoid.Health
	Events[#Events+1] = Humanoid.Changed:Connect(function(Property)
		local NewHealth = Humanoid.Health
		if not IgnoreHealthChange and NewHealth ~= Humanoid.MaxHealth and NewHealth > 0 then
			if NewHealth < CurrentHealth then
				local DamageDealt = (CurrentHealth - NewHealth)
				IgnoreHealthChange = true
				Humanoid.Health = Humanoid.Health + (DamageDealt * .67)
				IgnoreHealthChange = false
			end
		end
		CurrentHealth = NewHealth
	end) 

	Events[#Events+1] = Tool.Activated:Connect(Activated)
	Events[#Events+1] = Handle.Touched:Connect(Touched)
	Sounds.Equip:Play()
	Animations.EquipAnim:Play()
	Animations.IdleAnim:Play()
	
	Events[#Events+1] = Remote.OnServerEvent:Connect(function(client,Key)
		if not Tool.Enabled or client ~= Player or not Key or Humanoid.Health <= 0 or not Special then return end
		Tool.Enabled = false
		Special = false
		Effect.Enabled = false
		
		delay(2,function()
			Tool.Enabled = true
		end)
		
		Vanquish()
		
		delay(30,function()
			Effect.Enabled = true
			Special = true
		end)
	end)
end

function Unequipped()
	
	for _,anim in pairs(Animations) do
		if anim then
			anim:Stop()
		end
	end
	Animations = {}
	
	for i=1,#Events do
		if Events[i] then Events[i]:Disconnect();Events[i] = nil end
	end
	Events = {}
	
	for i=1,#Deletables do
		if Deletables[i] then Deletables[i]:Destroy() end
	end
	Deletables = {}
end


Tool.Equipped:Connect(Equipped)
Tool.Unequipped:Connect(Unequipped)]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
			<Item class="Script" referent="RBX0E8C61C732514BB5A13EBBB655B0A83A">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Vanquish</string>
					<string name="ScriptGuid">{57564E16-5571-4AB5-97E9-02348674853C}</string>
					<ProtectedString name="Source"><![CDATA[--The wave that made the vampires and bats no more!
--Stuns players, but eradicates all things bats and vampires!

local Creator, SpawnPos = script:FindFirstChild("Creator"), script:FindFirstChild("Position")

if not Creator or not Creator.Value or not SpawnPos then script:Destroy() end
--print("Vanquishing")

SpawnPos = SpawnPos.Value

local Services = {
	Players = (game:FindService("Players") or game:GetService("Players")),
	Debris = (game:FindService("Debris") or game:GetService("Debris")),
	RunService = (game:FindService("RunService") or game:GetService("RunService")),
	ServerScriptService = (game:FindService("ServerScriptService") or game:GetService("ServerScriptService"))
}


function Create(ty)
	return function(data)
		local obj = Instance.new(ty)
		for k, v in pairs(data) do
			if type(k) == 'number' then
				v.Parent = obj
			else
				obj[k] = v
			end
		end
		return obj
	end
end

function IsInTable(Table,Value)
	for _,v in pairs(Table) do
		if v == Value then
			return true
		end
	end
	return false
end

function IsTeamMate(Player1, Player2)
	return (Player1 and Player2 and not Player1.Neutral and not Player2.Neutral and Player1.TeamColor == Player2.TeamColor)
end

function TagHumanoid(humanoid, player)
	local Creator_Tag = Instance.new("ObjectValue")
	Creator_Tag.Name = "creator"
	Creator_Tag.Value = player
	Services.Debris:AddItem(Creator_Tag, 2)
	Creator_Tag.Parent = humanoid
end

function UntagHumanoid(humanoid)
	for i, v in pairs(humanoid:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "creator" then
			v:Destroy()
		end
	end
end

local Vector,Cframe,ceil,huge,max,lower,find,Region,unpac,Seed = Vector3,CFrame,math.ceil,math.huge,math.max,string.lower,string.find,Region3,unpack,Random.new() -- pre-declaring these variables should help with latency

local WavePart = Create("Part"){
	Name = "Effect",
	Locked = true,
	CanCollide = false,
	Anchored = true,
	CastShadow = false,
	CFrame = Cframe.new(SpawnPos),
	Size = Vector.new(1,1,1),
	Material = Enum.Material.ForceField,
	Color = Color3.fromRGB(117,0,0),
	Parent = workspace
}
local WaveMesh = Create("SpecialMesh"){
	MeshType = Enum.MeshType.Sphere,
	Scale = Vector.new(0,0,0),
	Parent = WavePart
}

local IgnoreList = {}
local IgnoreHumanoids = {}
local Anims = {}

local TargetNames = {"undying", "vampire", "bat"} 

local function VanquishStun(Hum) -- Quick check to see if they're not stunned
	local Children = Services.ServerScriptService:GetChildren()
	for i=1, #Children do
		if Children[i]:IsA("Script") and Children[i].Name == "VanquishStun" and Children[i]:FindFirstChild("Target") and Children[i]:FindFirstChild("Target").Value == Hum.Parent then
			return true
		end
	end
	return false
end

local function FoundTarget(Character)
	
	for i=1,#TargetNames do --check to see if the target is potentially a bat or a vampire
		if not Services.Players:GetPlayerFromCharacter(Character) and find(lower(Character.Name), lower(TargetNames[i])) then
			return true
		end
		local Descendants = Character:GetDescendants()
		for v = 1, #Descendants do
			if (Descendants[v]:IsA("BasePart") or Descendants[v]:IsA("Model") or Descendants[v]:IsA("Tool")) and find(lower(Descendants[v].Name), lower(TargetNames[i])) then
				--Target sighted!
				return true
			end
		end
	end
	return false
end

local function StunArea(Range)
	if not WavePart then return end
	local Position = WavePart.Position
	local Neg, Pos = Position - Vector.new(1,1,1) * (Range*.5), Position + Vector.new(1,1,1) * (Range*.5)
	local Reg = Region.new(Neg,Pos)
	local Parts = workspace:FindPartsInRegion3WithIgnoreList(Reg,{(Creator and Creator.Value and Creator.Value.Character) or nil,unpac(IgnoreList)},huge) 

	for i=1,#Parts,1 do
		if Parts[i] and Parts[i].Parent and (Parts[i].Position-Position).Magnitude <= Range then
			IgnoreList[#IgnoreList+1] = Parts[i] -- Ignore it so lag is mitigated
			
			local Hum,FF = Parts[i].Parent:FindFirstChildOfClass("Humanoid"),Parts[i].Parent:FindFirstChildOfClass("ForceField")
			if Hum and Hum.Health ~= 0 and not FF and not IsInTable(IgnoreHumanoids,Hum) and not IsTeamMate(Creator.Value, Services.Players:GetPlayerFromCharacter(Hum.Parent)) then
				IgnoreHumanoids[#IgnoreHumanoids+1] = Hum
				if FoundTarget(Hum.Parent) then
					
					warn("Target Sighted!")
					
					UntagHumanoid(Hum)
					TagHumanoid(Hum,Creator.Value)
					Hum.Parent:BreakJoints() --Make sure it KOs
					
					local EffectBox = Create("Part"){
						Locked = true,
						Anchored = true,
						CanCollide = false,
						TopSurface = Enum.SurfaceType.Smooth,
						BottomSurface = Enum.SurfaceType.Smooth,
						Size = Vector3.new(0,0,0),
						CFrame = Parts[i].CFrame,
						Transparency = 1,
						Parent = workspace
					}
					
					local PoofSmoke = script:WaitForChild("PoofSmoke"):Clone()
					PoofSmoke.Parent = EffectBox
					PoofSmoke:Emit(100)
					
					local PoofSound = script:WaitForChild("PoofSound"):Clone()
					PoofSound.Parent = EffectBox
					PoofSound:Play()
					
					Services.Debris:AddItem(EffectBox,max(PoofSmoke.Lifetime.Max,PoofSound.TimeLength)+.5)
					
					for _,parts in pairs(Hum.Parent:GetDescendants()) do
						if parts:IsA("BasePart") then
							parts:Destroy()
						end
					end
					
					else
						if not VanquishStun(Hum) then
							--local HeadShake = Hum:LoadAnimation(script:WaitForChild("Animations"):WaitForChild(Hum.RigType.Name):WaitForChild("HeadShake"))
							--HeadShake:Play(nil,nil,Seed:NextNumber(1,3))
							local VanquishScript = script:WaitForChild("VanquishStun"):Clone()
							Create("ObjectValue"){
								Name = "Target",
								Value = Hum.Parent,
								Parent = VanquishScript
							}
							VanquishScript.Parent = Services.ServerScriptService
							VanquishScript.Disabled = false
						end
				end
				--print("Affecting "..Hum.Parent.Name)
			end	
		end
	end
end

for i=1, ceil(60*(3)),1 do
	if WaveMesh and WavePart then
		WaveMesh.Scale = Vector.new(1,1,1)* (300 * (i/ceil(60*(3))))
		WavePart.Transparency = (i/ceil(60*(3)))
		coroutine.wrap(function()
			StunArea((300 * (i/ceil(60*(3)))))
		end)()
	end

	Services.RunService.Stepped:Wait()
end

if WavePart then
	WavePart:Destroy()
end

for i=1,#Anims do
	if Anims[i] then Anims[i]:Stop() end
end

script:Destroy()]]></ProtectedString>
