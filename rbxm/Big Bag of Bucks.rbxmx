		<Item class="Script" referent="RBX1CD6EC21A5944D649FC7A9C8D22A84CF">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="ScriptGuid">{FFCEBC8B-2BB1-4E72-AE52-51877FCC165D}</string>
				<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Handle = Tool.Handle
local Effect = Tool.Effect

function Equipped()	
	Effect.Transparency = 0.65
end

function Unequipped()
	Effect.Transparency = 1
end

Tool.Equipped:Connect(Equipped)
Tool.Unequipped:Connect(Unequipped)

Tool:GetPropertyChangedSignal("CanBeDropped"):Connect(function()
	Tool.CanBeDropped = false
end)]]></ProtectedString>
