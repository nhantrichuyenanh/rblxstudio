		<Item class="Script" referent="RBX800E4A618DCF498D8CDE23C087C359CA">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="ScriptGuid">{319A0033-A49B-4F43-BC43-995C1A3E31B6}</string>
				<ProtectedString name="Source"><![CDATA[-- // Created by StarWars
local InsertService = game:GetService("InsertService")

local GearService = require(1075123174)

local tool = script.Parent
local gear = GearService:BindGear(tool, "Mount")

local tiger = InsertService:LoadAsset(2713350844)
tiger = tiger:GetChildren()[1]

gear.Class:SetMountModel(tiger)]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
