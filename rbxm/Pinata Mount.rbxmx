		<Item class="Script" referent="RBXBE354896044244819E3A2A609AF2E37D">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="ScriptGuid">{0CA2EA3A-4B6F-41C4-9DB9-474B94350937}</string>
				<ProtectedString name="Source"><![CDATA[-- // Created by StarWars
local InsertService = game:GetService("InsertService")

local Tool = script.Parent
local Display = Tool:FindFirstChild("Display")
if Display then
	Display:Destroy()
end

local PinataModel = InsertService:LoadAsset(1664679743)
PinataModel = PinataModel:GetChildren()[1]

local GearService = require(1075123174)

local Gear = GearService:BindGear(Tool, "Mount")
Gear.Class:SetMountModel(PinataModel)]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
