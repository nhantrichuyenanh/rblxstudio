		<Item class="LocalScript" referent="RBX150157DC552E4A9EA414522C774DDFDC">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Local Gui</string>
				<string name="ScriptGuid">{AE88AB54-AD24-411C-AFD0-8298993DD120}</string>
				<ProtectedString name="Source"><![CDATA[Tool=script.Parent
function onEquippedLocal(mouse)
	if mouse == nil then
		print("Mouse not found")
		return 
	end
	mouse.Icon = "rbxasset://textures\\GunCursor.png"
end

Tool.Equipped:connect(onEquippedLocal)]]></ProtectedString>
