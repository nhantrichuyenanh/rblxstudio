		<Item class="Script" referent="RBX6CAE3BA67A504F08B6AD5271C557B431">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="ScriptGuid">{85AD97A7-FD3A-41A1-9960-D713E4A3404E}</string>
				<ProtectedString name="Source"><![CDATA[-- // Created by StarWars
local InsertService = game:GetService("InsertService")

local GearService = require(1075123174)

local tool = script.Parent
local gear = GearService:BindGear(tool, "Mount")

local mooseMount = InsertService:LoadAsset(2646363772)
mooseMount = mooseMount:GetChildren()[1]

gear.Class:SetMountModel(mooseMount)]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
