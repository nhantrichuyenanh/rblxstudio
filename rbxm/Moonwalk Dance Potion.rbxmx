			<Item class="Folder" referent="RBXB36DF29CA69245D9931B3A0609786040">
				<Properties>
					<string name="Name">R6</string>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
				<Item class="Animation" referent="RBX46201AF7CF534E0398C72A9765F9650B">
					<Properties>
						<Content name="AnimationId"><url>http://www.roblox.com/Asset?ID=30196114</url></Content>
						<string name="Name">moonwalk</string>
						<BinaryString name="Tags"></BinaryString>
					</Properties>
				</Item>
			</Item>
			<Item class="Folder" referent="RBXAA20BC3FE4DF474A994FBD5268B2B420">
				<Properties>
					<string name="Name">R15</string>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
				<Item class="Animation" referent="RBXC1B316E13FDB4230A0DDB4407C5E207A">
					<Properties>
						<Content name="AnimationId"><url>rbxassetid://854410608</url></Content>
						<string name="Name">moonwalk</string>
						<BinaryString name="Tags"></BinaryString>
					</Properties>
				</Item>
			</Item>
		</Item>
		<Item class="LocalScript" referent="RBX81B3F352452C45FE8D2E6BDA6135AB5E">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LocalScript</string>
				<string name="ScriptGuid">{C6071DC3-4F0F-49AE-B828-9579D579D866}</string>
				<ProtectedString name="Source"><![CDATA[local Tool = script.Parent

local ServerControls = Tool:WaitForChild("ServerControls")
local Animations = Tool:WaitForChild("Animations")
local R6Folder = Animations:WaitForChild("R6")
local R15Folder = Animations:WaitForChild("R15")

local Character = nil
local Humanoid = nil

local MoonWalkAnim = nil

ServerControls.OnClientEvent:Connect(function()
	if not MoonWalkAnim then return end

	MoonWalkAnim:Play(0.1, 1, 2)
end)

function OnEquipped()
	Character = Tool.Parent
	Humanoid = Character:FindFirstChildOfClass("Humanoid")

	if Humanoid then
		if Humanoid.RigType == Enum.HumanoidRigType.R15 then
			MoonWalkAnim = Humanoid:LoadAnimation(R15Folder:WaitForChild("moonwalk"))
		else
			MoonWalkAnim = Humanoid:LoadAnimation(R6Folder:WaitForChild("moonwalk"))
		end
	end
end

function OnUnequipped()
	Character = nil
	Humanoid = nil
	if MoonWalkAnim then
		MoonWalkAnim:Stop()
		MoonWalkAnim:Destroy()
	end

	MoonWalkAnim = nil
end

Tool.Unequipped:Connect(OnUnequipped)
Tool.Equipped:Connect(OnEquipped)]]></ProtectedString>
