		<Item class="Script" referent="RBX61D8D9398BAF4EA28DD17ABCC3B63C72">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="ScriptGuid">{2E7675D4-256F-42F4-9EE7-0620A5A5C4FE}</string>
				<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Handle = Tool.Handle

local Pom = Handle:Clone()
Pom.Name = "LeftPom"

local Character = nil
local LeftGripAttachment = nil 
local LeftPom = nil

local ToolEquipped = false

local function WeldPom()
	if LeftPom then
		LeftPom:Destroy()
	end
	
	LeftPom = Pom:Clone()
	LeftPom.Parent = Tool
	
	local Motor6D = Instance.new("Motor6D")
	Motor6D.Part0 = LeftGripAttachment.Parent
	Motor6D.Part1 = LeftPom
	Motor6D.C0 = CFrame.new()
	Motor6D.C1 = CFrame.new(LeftGripAttachment.Position)
	Motor6D.Parent = LeftGripAttachment.Parent
end

function Equipped()
	if ToolEquipped then return end 
	ToolEquipped = true
	Character = Tool.Parent
	local LeftArm = Character:FindFirstChild("Left Arm") or Character:FindFirstChild("LeftHand")
	LeftGripAttachment = LeftArm:FindFirstChild("LeftGripAttachment")
	WeldPom()
end

function Unequipped()
	Character = nil
	LeftGripAttachment = nil
	ToolEquipped = false
end

Tool.Equipped:Connect(Equipped)
Tool.Unequipped:Connect(Unequipped)]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
		<Item class="LocalScript" referent="RBX48C421C7032D43C1897309D14CC1D75F">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LocalScript</string>
				<string name="ScriptGuid">{46580B4F-3900-40FF-8D6B-3732DB0342C2}</string>
				<ProtectedString name="Source"><![CDATA[local Tool = script.Parent

local R15Dance = Tool:WaitForChild("R15Dance")
local Dance = Tool:WaitForChild("Dance")

local Character = nil
local Humanoid = nil
local Animation = nil

local Dancing = false

function Equipped()
	Character = Tool.Parent
	Humanoid = Character:WaitForChild("Humanoid")
	local Anim = Dance 
	if Humanoid and Humanoid.RigType == Enum.HumanoidRigType.R15 then
		Anim = R15Dance
	end
	Animation = Humanoid:LoadAnimation(Anim)
end

function Unequipped()
	if Animation then
		Animation:Stop()
	end
	Animation = nil
	Humanoid = nil
	Character = nil
end

function Activated()
	if Dancing then return end 
	Dancing = true
	local CacheSpeed = 16
	if Humanoid then
		CacheSpeed = Humanoid.WalkSpeed
	end 
	if Animation then	
		Humanoid.WalkSpeed = 0
		Animation:Play()
	end
	
	wait(3)
	if Humanoid then
		Humanoid.WalkSpeed = CacheSpeed
	end 	
	Dancing = false
end

Tool.Equipped:Connect(Equipped)
Tool.Unequipped:Connect(Unequipped)
Tool.Activated:Connect(Activated)]]></ProtectedString>
