		<Item class="Script" referent="RBX83638B2C22DD4FCE895214961BF35D8B">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="ScriptGuid">{620161A8-E295-4072-B6B8-28766067200F}</string>
				<ProtectedString name="Source"><![CDATA[local GearService = require(1075123174)

local Tool = script.Parent
local Gear = GearService:BindGear(Tool, "Sword")
Gear.Class:SetLungeDamage(20)
Gear.Class:SetSlashDamage(10)
Gear.Class:SetGripOut(Tool.Grip)
Gear:BindEquippedFunction("InsertAnimation", function()
	if Gear.Humanoid and Gear.Humanoid.RigType == Enum.HumanoidRigType.R15 then
		local NewAnimation = Instance.new("Animation")
		NewAnimation.AnimationId = "rbxassetid://1088114329"
		Gear.Class:BindLungeAnimation(NewAnimation)
	else
		local NewAnimation = Instance.new("Animation")
		NewAnimation.AnimationId = "rbxassetid://1088118628"
		Gear.Class:BindLungeAnimation(NewAnimation)
	end
end)]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
		<Item class="LocalScript" referent="RBX3FB28AAAF66740258E78E65253FBA6A7">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">MouseIcon</string>
				<string name="ScriptGuid">{43E2F395-C880-4892-9762-1B115570D063}</string>
				<ProtectedString name="Source"><![CDATA[Mouse_Icon = "rbxasset://textures/GunCursor.png"
Reloading_Icon = "rbxasset://textures/GunWaitCursor.png"

Tool = script.Parent

Mouse = nil

function UpdateIcon()
	if Mouse then
		Mouse.Icon = Tool.Enabled and Mouse_Icon or Reloading_Icon
	end
end

function OnEquipped(ToolMouse)
	Mouse = ToolMouse
	UpdateIcon()
end

Tool:GetPropertyChangedSignal("Enabled"):Connect(UpdateIcon)
Tool.Equipped:connect(OnEquipped)]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
