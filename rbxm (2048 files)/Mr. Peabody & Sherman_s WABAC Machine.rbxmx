		<Item class="Script" referent="RBX4CB9923EAB3C4440A5807951AF76AF57">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Deploy</string>
				<string name="ScriptGuid">{C7896AD8-E56D-4B50-A891-F52AE1E4472E}</string>
				<ProtectedString name="Source"><![CDATA[--Made by Stickmasterluke
--Fixed by TakeoHonorable

sp=script.Parent


local debris=game:GetService("Debris")
equipped=false
check=true


sp.Activated:Connect(function()
	local chr=sp.Parent
	if chr and check and equipped then
		local t=chr:FindFirstChild("HumanoidRootPart")
		local h=chr:FindFirstChildOfClass("Humanoid")
		local animobject1=sp:FindFirstChild("ButtonPress"..h.RigType.Name)
		local animobject2=sp:FindFirstChild("Toss"..h.RigType.Name)
		if t and h and animobject1 and animobject2 and equipped then
			if h.Health>0 then
				check=false
				local anim1=h:LoadAnimation(animobject1)
				if anim1 and h and h.Health>0 and equipped then
					anim1:Play()
					wait(1.6)
					sp.Handle.BeepTone:Play()
					wait(.6)
					sp.Handle.BeepTone:Play()
					wait(.5)
				end
				local anim2=h:LoadAnimation(animobject2)
				if anim2 and h and h.Health>0 and equipped then
					anim2:Play()
					wait(1.2)
				end
				if equipped then
					local p=sp.Handle:Clone()
					p.CanCollide=true
					p.Name="Jump Point"
					p.Anchored=false
					p.Velocity=(t.CFrame.lookVector*20)+Vector3.new(0,20,0)
					local s=script:WaitForChild("Script"):Clone()
					s.Parent=p
					s.Disabled=false
					local gui=sp.JumpPointGui:Clone()
					gui.Parent=p
					local ct=Instance.new("ObjectValue")
					ct.Name="creator"
					ct.Value=game.Players:GetPlayerFromCharacter(chr)
					ct.Parent=p
					local gyro=Instance.new("BodyGyro")		--this will keep the thing standing upright.
					gyro.Parent=p
					p.Parent=game.Workspace
					p:SetNetworkOwner(game.Players:GetPlayerFromCharacter(chr))
					sp:Destroy()
				end
				check=true
			end
		end
	end
end)

sp.Unequipped:Connect(function()
	equipped=false
end)

sp.Equipped:Connect(function()
	equipped = true
end)

]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
			<Item class="Script" referent="RBX6D0DD10B2FB8416FBAC4F9D25D53DEE0">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="ScriptGuid">{B4FF01D7-489D-465C-B23A-FFDFF487AFEE}</string>
					<ProtectedString name="Source"><![CDATA[--Made by Stickmasterluke
--Fixed by TakeoHonorable

sp=script.Parent


scale=.5
jumpcooldown=1
color=BrickColor.new("Bright red")
transparency=.5
rate=1/30

local lastjump=tick()
local debris=game:GetService("Debris")
local cf=CFrame.new()
local mesh=sp:WaitForChild("Mesh")

function waitfor(a,b,c)
	local c=c or 5*60
	local d=tick()+c
	while a:FindFirstChild(b)==nil and tick()<=d do
		wait()
	end
	return a:FindFirstChild(b)
end

wait(3)

local sbp=Instance.new("BodyPosition")
sbp.maxForce=Vector3.new(1,1,1)*(10^7)
sbp.position=sp.Position+Vector3.new(0,15,0)
sbp.Parent=sp

local frames=1/rate
for frame=1,frames do
	local newscale=(1+(5*(frame/frames)))
	sp.Size=Vector3.new(2,2,2)*newscale
	mesh.Scale=Vector3.new(1,1,1)*newscale
	wait(rate)
end

local ct=waitfor(sp,"creator",5)
if ct then
	if ct.Value and ct.Value.Character then
		gui=sp:FindFirstChild("JumpPointGui")
		if gui then
			local jumpbutton=gui:FindFirstChild("JumpButton")
			local plrgui=ct.Value:FindFirstChild("PlayerGui")
			if plrgui and jumpbutton then
				gui.Parent=plrgui
				jumpbutton.MouseButton1Down:Connect(function()
					if ct and ct.Value and ct.Value.Character and tick()-lastjump>jumpcooldown then
						local torso=ct.Value.Character:FindFirstChild("HumanoidRootPart")
						local humanoid=ct.Value.Character:FindFirstChildOfClass("Humanoid")
						if torso and humanoid and humanoid.Health>0 then
							local sound=sp:FindFirstChild("WarpSound")
							if sound then
								sound:Play()
							end
							local tcf=torso.CFrame
						
							local p=Instance.new("Part")
							p.BrickColor=color
							p.FormFactor="Custom"
							p.Size=Vector3.new(0,0,0)
							p.Anchored=true
							p.CanCollide=false
							p.TopSurface="Smooth"
							p.BottomSurface="Smooth"
							p.Material = Enum.Material.Neon
							p.Name="Effect"
							local m=Instance.new("SpecialMesh")
							m.MeshType="Sphere"
							m.Parent=p
							debris:AddItem(p,5)
							p.CFrame=tcf
							p.Parent=game.Workspace

							ct.Value.Character:MoveTo(sp.Position)

							local p2=Instance.new("Part")
							p2.BrickColor=color
							p2.FormFactor="Custom"
							p2.Size=Vector3.new(0,0,0)
							p2.Anchored=true
							p2.CanCollide=false
							p2.TopSurface="Smooth"
							p2.BottomSurface="Smooth"
							p2.Material = Enum.Material.Neon
							p2.Name="Effect"
							local m2=Instance.new("SpecialMesh")
							m2.MeshType="Sphere"
							m2.Parent=p2
							debris:AddItem(p2,5)
							p2.CFrame=torso.CFrame
							p2.Parent=game.Workspace

							delay(0,function()
								frames=.5/rate
								for frame=1,frames do
									local percent=frame/frames
									m.Scale=Vector3.new(15,15,15)*(1-percent)*8
									p.Transparency=percent
									m2.Scale=Vector3.new(15,15,15)*percent*8
									p2.Transparency=percent
									wait(rate)
								end
							end)
							lastjump=tick()
						end
					end
				end)
			end
		end
		while ct and ct.Value and ct.Value.Character and ct.Value.Character:FindFirstChildOfClass("Humanoid") and ct.Value.Character:FindFirstChildOfClass("Humanoid").Health>0 and gui and gui.Parent do
			wait(.15)
		end
	end
end

if gui then
	gui:Destroy()
end
local e=Instance.new("Explosion")
e.BlastPressure=0
e.Position=sp.Position
e.Parent=game.Workspace
									--Maybe add a sound
wait(.5)
sp:Destroy()









]]></ProtectedString>
