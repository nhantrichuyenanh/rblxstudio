		<Item class="LocalScript" referent="RBX08448EBA4E2043AE8F91B3D3AC92FA09">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">AnimateWand</string>
				<string name="ScriptGuid">{2E42B80D-2648-4DEC-89C0-2270191C6955}</string>
				<ProtectedString name="Source"><![CDATA[-- // Created by StarWars
local RunService = game:GetService("RunService")

local tool = script.Parent
local wandMotorsFolder = tool:WaitForChild("WandMotors")

local count = 0

local SPEED = 10

RunService.Stepped:Connect(function(_, step)
	for _, motor in pairs(wandMotorsFolder:GetChildren()) do
		if motor:IsA("Motor6D") then
			motor.Transform = motor.Transform * CFrame.Angles(0, 0, math.rad(count))
		end
	end
	count = (count + (step * SPEED)) % 360
end)]]></ProtectedString>
