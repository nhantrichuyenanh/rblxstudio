					<string name="Name">SlowScript</string>
					<string name="ScriptGuid">{D78F9E55-BD75-441B-A37F-8867CA161BBC}</string>
					<ProtectedString name="Source"><![CDATA[local vCharacter = script.Parent
local myHumanoid = vCharacter:FindFirstChildOfClass("Humanoid")

if myHumanoid and myHumanoid.Health > 0 then 
	myHumanoid.WalkSpeed = 9.0 
	wait(2.5)
	myHumanoid.WalkSpeed = 16.0
end 

wait(2.0)
if script then script:Destroy() end
]]></ProtectedString>
