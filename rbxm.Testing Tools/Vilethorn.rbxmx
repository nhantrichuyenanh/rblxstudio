		<Item class="Script" referent="RBX8D37DF09C4FA412B95B2AD472D7ED565">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">SwordScript</string>
				<string name="ScriptGuid">{C1840469-8B23-4031-848D-2E3C6495856B}</string>
				<ProtectedString name="Source"><![CDATA[r = game:service("RunService") 
local sword = script.Parent.Handle 
local Tool = script.Parent 

local damage = 14

local slash_damage = 18
local lunge_damage = 20

local SlashSound = Instance.new("Sound") 
SlashSound.SoundId = "rbxasset://sounds\\swordslash.wav" 
SlashSound.Parent = sword 
SlashSound.Volume = .7 

local LungeSound = Instance.new("Sound") 
LungeSound.SoundId = "rbxasset://sounds\\swordlunge.wav" 
LungeSound.Parent = sword 
LungeSound.Volume = .6 

local UnsheathSound = Instance.new("Sound") 
UnsheathSound.SoundId = "rbxasset://sounds\\unsheath.wav" 
UnsheathSound.Parent = sword 
UnsheathSound.Volume = 1 

local thornActive

local debris = game:GetService("Debris")

function blow(hit) 
	local humanoid = hit.Parent:findFirstChild("Humanoid") 
	local vCharacter = Tool.Parent 
	local vPlayer = game.Players:playerFromCharacter(vCharacter) 
	local hum = vCharacter:findFirstChild("Humanoid") -- non-nil if tool held by a character 
	if humanoid~=nil and humanoid ~= hum and hum ~= nil then           
		-- final check, make sure sword is in-hand 
		local right_arm = vCharacter:FindFirstChild("Right Arm") or vCharacter:FindFirstChild("RightHand")
		if (right_arm ~= nil) then 
			local joint = right_arm:FindFirstChild("RightGrip") 
			if (joint ~= nil and (joint.Part0 == sword or joint.Part1 == sword)) then 
				tagHumanoid(humanoid, vPlayer)                                                         
				humanoid:TakeDamage(damage) 				                     
				thornActive = Tool:FindFirstChild("ThornActive")
				if thornActive.Value == 1 then 
					thornActive.Value = 0
					sparkle = sword:FindFirstChild("SPARK")
					if sparkle then sparkle:Destroy() end
					tempChar = hit.Parent
					thorn = tempChar:FindFirstChild("ThornScript")
					if thorn == nil then 
						thorn = Tool.ThornScript:Clone()						
						thorn.Parent = tempChar
						thorn.Disabled = false
					end
				end
			end 
		end 
	end 
end 


function tagHumanoid(humanoid, player) 
	local creator_tag = Instance.new("ObjectValue") 
	creator_tag.Value = player 
	creator_tag.Name = "creator" 
	creator_tag.Parent = humanoid 
	debris:addItem(creator_tag, 1)
end 

function attack() 
     damage = slash_damage 
     SlashSound:play() 
     local anim = Instance.new("StringValue") 
     anim.Name = "toolanim" 
     anim.Value = "Slash" 
     anim.Parent = Tool 
end 

function lunge() 
     damage = lunge_damage 
     LungeSound:play() 


     local anim = Instance.new("StringValue") 
     anim.Name = "toolanim" 
     anim.Value = "Lunge" 
     anim.Parent = Tool 
      
     force = Instance.new("BodyVelocity") 
     force.velocity = Vector3.new(0,10,0) --Tool.Parent.Torso.CFrame.lookVector * 80 
     force.Parent = Tool.Parent:FindFirstChild("Torso") or Tool.Parent:FindFirstChild("UpperTorso") 
     wait(.2) 
     swordOut() 
     wait(.2) 
     force.Parent = nil 
     wait(.4) 
     swordUp() 
     damage = slash_damage 
end 

function swordUp() 
     Tool.GripForward = Vector3.new(-1,0,0) 
     Tool.GripRight = Vector3.new(0,0,-1) 
     Tool.GripUp = Vector3.new(0,1, 0) 
end 

function swordOut() 
     Tool.GripForward = Vector3.new(0, -1, 0) 
     Tool.GripRight = Vector3.new(0, 0, -1) 
     Tool.GripUp = Vector3.new(1, 0, 0) 
end 

Tool.Enabled = true 
local last_attack = 0 

function onActivated() 		
	if not Tool.Enabled then 
		 return 
	end 
	Tool.Enabled = false 

	local character = Tool.Parent; 
	local humanoid = character.Humanoid 
	if humanoid == nil then 
		 print("Humanoid not found") 
		 return 
	end 

	t = r.Stepped:wait() 

	if (t - last_attack < .2) then 
		 lunge() 
	else 
		 attack() 
	end 

	last_attack = t 

	--wait(0.5) 

	Tool.Enabled = true 
end 

function onEquipped()      
	UnsheathSound:play()      
	thornActive = Tool:FindFirstChild("ThornActive")
end 

script.Parent.Activated:connect(onActivated) 
script.Parent.Equipped:connect(onEquipped) 

connection = sword.Touched:connect(blow) 
]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
		<Item class="LocalScript" referent="RBX26ACBDBC08E142D19EE92929BB75A540">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LocalSwordScript</string>
				<string name="ScriptGuid">{91878E57-9012-4819-93B3-5085FA466748}</string>
				<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Sword = Tool.Handle

local vCharacter

local thornActive 

local greenFire

local co

local sparkle

function wait20()
	wait(7.5)
	thornActive = Tool:FindFirstChild("ThornActive")
	if thornActive then thornActive.Value = 0 end
	if sparkle then sparkle:Remove() end
	wait(12.5)
end

function onKeyDown(key)
	if key:lower() == "x" then
		if co == nil or coroutine.status(co) == 'dead' then	
			co = coroutine.create(wait20)
			coroutine.resume(co)
			vCharacter = Tool.Parent
			myHumanoid = vCharacter:findFirstChild("Humanoid")
			thornActive = Tool:FindFirstChild("ThornActive")
			if myHumanoid ~= nil and thornActive then                                              
				thornActive.Value = 1        
				sparkle = Instance.new("Sparkles")
				sparkle.SparkleColor = Color3.new(0, 0.9, 0)
				sparkle.Name = "SPARK"
				sparkle.Parent = Sword
			end
		end
	end
end

function onEquippedLocal(mouse)
     mouse.KeyDown:connect(onKeyDown)
end

function onUnequippedLocal()
	thornActive = Tool:FindFirstChild("ThornActive")
	if thornActive then thornActive.Value = 0 end
		
	if greenFire then greenFire:Remove() end
end

Tool.Equipped:connect(onEquippedLocal)
Tool.Unequipped:connect(onUnequippedLocal) 
]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
		<Item class="NumberValue" referent="RBXA3CFF68F832F426784C49A7EE4AF77E6">
			<Properties>
				<string name="Name">ThornActive</string>
				<BinaryString name="Tags"></BinaryString>
				<double name="Value">0</double>
			</Properties>
		</Item>
		<Item class="Script" referent="RBXF4BE8764F9EB4390924EA9FD96891A7A">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">ThornScript</string>
				<string name="ScriptGuid">{D3A0CB6B-BF22-4DD8-934A-8C153FE2D93F}</string>
				<ProtectedString name="Source"><![CDATA[local vCharacter = script.Parent
local myTorso = vCharacter:FindFirstChild("Torso")
local myHumanoid = vCharacter:FindFirstChild("Humanoid")
print(myTorso)

local thorn
local thornWeld 

local duration = 3.5

if myTorso and myHumanoid then
	myHumanoid.WalkSpeed = 0
	thorn = Instance.new("Part")
	thorn.FormFactor = 3
	thorn.Shape = "Block"
	thorn.Size = Vector3.new(2, 4, 2)
	thorn.CanCollide = true
	thorn.Position = myTorso.Position
	thorn.Parent = vCharacter	

	thornMesh = Instance.new("SpecialMesh")
	thornMesh.MeshId = "http://www.roblox.com/asset/?id=54653968"
	thornMesh.TextureId = "http://www.roblox.com/asset/?id=54654008"
	thornMesh.Scale = Vector3.new(1.0, 1.0, 0.8)
	thornMesh.Parent = thorn

	thornWeld = Instance.new("Weld")
	thornWeld.Parent = myTorso
	thornWeld.Part0 = myTorso
	thornWeld.Part1 = thorn
	thornWeld.C1 = CFrame.new(Vector3.new(0, 0, 0))		

	print("THORN CREATED")	
		
	myTorso.Anchored = true	
end

print(duration)
while duration > 0 do 
	duration = duration - 0.5	
	wait(0.5)
end

if thorn then thorn:Remove() end
if thornWeld then thornWeld:Remove() end
if myTorso then myTorso.Anchored = false end
if myHumanoid then myHumanoid.WalkSpeed = 16 end

wait(2.0)
script:Remove()
]]></ProtectedString>
