		<Item class="Script" referent="RBX997BED7F5973439285286145FE2355F4">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="ScriptGuid">{2800B139-3CBC-4B04-BFA2-24687F63B361}</string>
				<ProtectedString name="Source"><![CDATA[-- // Created by StarWars

local tool = script.Parent

local humanoid = nil
local cacheSpeed = nil

local SPEED_BOOST = 24

function onEquipped()
	local character = tool.Parent
	humanoid = character:FindFirstChildOfClass("Humanoid")
	
	if humanoid then
		cacheSpeed = humanoid.WalkSpeed
		humanoid.WalkSpeed = SPEED_BOOST
	end
end

function onUnequipped()
	if humanoid then
		if cacheSpeed then
			humanoid.WalkSpeed = cacheSpeed
		end
	end
	
	humanoid = nil
	cacheSpeed = nil
end

tool.Equipped:Connect(onEquipped)
tool.Unequipped:Connect(onUnequipped)]]></ProtectedString>
