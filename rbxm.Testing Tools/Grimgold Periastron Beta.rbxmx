						<ProtectedString name="Source"><![CDATA[local Tint = script:WaitForChild("SONARTint",10)

local TintFound = workspace.CurrentCamera:FindFirstChild(Tint.Name)

if TintFound then return end

Tint.Parent = workspace.CurrentCamera]]></ProtectedString>
						<BinaryString name="Tags"></BinaryString>
					</Properties>
				</Item>
				<Item class="ColorCorrectionEffect" referent="RBX52918453886C4A328C86B5E313287C17">
