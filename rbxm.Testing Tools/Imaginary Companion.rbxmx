		<Item class="Script" referent="RBXB9D86B824F1B472198B43563F719E534">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="ScriptGuid">{A3A1902C-B772-43E4-8FC8-59C8FBB9F34A}</string>
				<ProtectedString name="Source"><![CDATA[-- // Created by StarWars
local InsertService = game:GetService("InsertService")

local Tool = script.Parent
Tool.RequiresHandle = false

if Tool:FindFirstChild("Handle") then
	Tool.Handle:Destroy()
end

if Tool:FindFirstChild("Display") then
	Tool.Display:Destroy()
end

local AIScript = script.AIScript

local ImaginaryFriend = InsertService:LoadAsset(2467538867)
ImaginaryFriend = ImaginaryFriend:GetChildren()[1]:Clone()
AIScript.Parent = ImaginaryFriend
AIScript.Disabled = false

local CurrentImaginaryFriend = nil
local Character = nil

function OnEquipped()
	Character = Tool.Parent
	CurrentImaginaryFriend = ImaginaryFriend:Clone()
	local Owner = Instance.new("ObjectValue")
	Owner.Name = "Owner"
	Owner.Value = Character
	Owner.Parent = CurrentImaginaryFriend
	
	CurrentImaginaryFriend.Name = Character.Name .. "'s_ImaginaryFriend"
	CurrentImaginaryFriend.Parent = workspace
	CurrentImaginaryFriend:MakeJoints()
	CurrentImaginaryFriend:MoveTo((Owner.Value.PrimaryPart.CFrame * CFrame.new(4, 0, 3)).p)
end

function OnUnequip()
	if CurrentImaginaryFriend then 
		CurrentImaginaryFriend:Destroy()
	end
	
	CurrentImaginaryFriend = nil
	Character = nil
end

Tool.Equipped:Connect(OnEquipped)
Tool.Unequipped:Connect(OnUnequip)]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
			<Item class="Script" referent="RBX87166CA9F1294E58B28CF6372DE95B65">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">AIScript</string>
					<string name="ScriptGuid">{30E8FCBE-E998-42AB-A1E6-64AAD3773D83}</string>
					<ProtectedString name="Source"><![CDATA[-- // Created by StarWars
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local ImaginaryFriend = script.Parent
local Humanoid = ImaginaryFriend:WaitForChild("Humanoid")
local Owner = ImaginaryFriend:WaitForChild("Owner")

local Head = ImaginaryFriend:FindFirstChild("Head")
if Head then
	local Gui = Head:FindFirstChild("BillboardGui")
	if Gui then
		Gui.Enabled = true
		Debris:AddItem(Gui, 5)
	end
	
end

local function RayCast(start, direction)
	local NewRay = Ray.new(start, direction * 999)
	
	local HitPart, Endpoint = workspace:FindPartOnRay(NewRay)
	
	return HitPart, Endpoint
end

RunService.Heartbeat:Connect(function(delta)
	local OwnerModel = Owner and Owner.Value
	
	if OwnerModel then	
		local Direction = (OwnerModel.PrimaryPart.Position - ImaginaryFriend.PrimaryPart.Position).Unit
		local Hit, Endpoint = RayCast(ImaginaryFriend.PrimaryPart.Position, Direction)
		
		Humanoid:MoveTo((OwnerModel.PrimaryPart.CFrame * CFrame.new(4, 0, 4)).p)
	end
end)]]></ProtectedString>
