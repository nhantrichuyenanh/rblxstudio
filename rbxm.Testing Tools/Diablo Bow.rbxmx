							<R20>1.00000501</R20>
							<R21>2.89827585e-06</R21>
							<R22>-5.96046448e-07</R22>
						</CoordinateFrame>
						<CoordinateFrame name="C1">
							<X>-2.66672897</X>
							<Y>-3.15191483</Y>
							<Z>-3.16228485</Z>
							<R00>-0.233077243</R00>
							<R01>-0.0297274683</R01>
							<R02>-0.972004294</R02>
							<R10>-0.127217203</R10>
							<R11>0.991875291</R11>
