		<Item class="Script" referent="RBX148CCF50BB664D53B6A0FD35A876DAC2">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="ScriptGuid">{91182B50-BEF5-45B0-AB4E-48F3CC7A8BFA}</string>
				<ProtectedString name="Source"><![CDATA[local GearService = require(1075123174)

local Tool = script.Parent
local Handle = Tool.Handle

local Trail = Handle:FindFirstChildOfClass("Trail")

local Gear = GearService:BindGear(Tool, "Sword")

Gear:BindActivateFunction("pot_of_gold_activate", function()
	if Trail then
		Trail.Enabled = true
		delay(0.2, function()
			if Trail then
				Trail.Enabled = false
			end
		end)
	end
end)]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
