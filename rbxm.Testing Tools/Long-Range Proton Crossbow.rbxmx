		</Item>
		<Item class="NumberValue" referent="RBX6D47D3BA5F304DA4B09E82167AAC3181">
			<Properties>
				<string name="Name">SpamArrow</string>
				<BinaryString name="Tags"></BinaryString>
				<double name="Value">0</double>
			</Properties>
		</Item>
		<Item class="LocalScript" referent="RBXE35BB5E0EE3046778A60046E6B21F67E">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">AnimateScript</string>
				<string name="ScriptGuid">{E4AF1DA7-2FAC-4DB4-85F1-DBB69E15A38D}</string>
				<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Bow = Tool.Handle

local vCharacter 
local walkAnim
local arrowAnim

local spamArrow
local co

local debounce = false

function onKeyDown(key)
	if key:lower() == "q" then 		
		if debounce == false then
			spamArrow = Tool:FindFirstChild("SpamArrow")
			if spamArrow then 
				spamArrow.Value = 1  
				co = coroutine.create(reset)
				coroutine.resume(co)
				debounce = true
			end	
		end
	end
end

function reset()
	wait(5)
	spamArrow = Tool:FindFirstChild("SpamArrow")
	if spamArrow then spamArrow.Value = 0 end
	wait(5)
	debounce = false
end

function onActivatedLocal()
	vCharacter = Tool.Parent
	myHumanoid = vCharacter:FindFirstChild("Humanoid")
	if myHumanoid == nil then 
		return
	end
	--arrowAnim = myHumanoid:LoadAnimation(Tool.ArrowAnim)
	if arrowAnim then arrowAnim:Play() end

	wait(1.0)
	
end

function onEquippedLocal(mouse)
	vCharacter = Tool.Parent
	myHumanoid = vCharacter:FindFirstChild("Humanoid")	

	mouse.KeyDown:connect(onKeyDown)
end

function onUnequippedLocal()
	if walkAnim then walkAnim:Stop() end	
	if arrowAnim then arrowAnim:Stop()end

	iceArrow = Tool:FindFirstChild("IceArrow")
	if iceArrow then iceArrow.Value = 0 end
end

Tool.Activated:connect(onActivatedLocal)
Tool.Equipped:connect(onEquippedLocal)
Tool.Unequipped:connect(onUnequippedLocal)
]]></ProtectedString>
