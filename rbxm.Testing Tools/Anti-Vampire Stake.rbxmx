		<Item class="LocalScript" referent="RBXF92B2C17979B45E8B0E41939C3A25C38">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">MouseIcon</string>
				<string name="ScriptGuid">{C031321F-30E6-4036-927C-BF383E06FE32}</string>
				<ProtectedString name="Source"><![CDATA[Mouse_Icon = "rbxasset://textures/GunCursor.png"
Reloading_Icon = "rbxasset://textures/GunWaitCursor.png"

Tool = script.Parent

Mouse = nil

function UpdateIcon()
	if Mouse then
		Mouse.Icon = Tool.Enabled and Mouse_Icon or Reloading_Icon
	end
end

function OnEquipped(ToolMouse)
	Mouse = ToolMouse
	UpdateIcon()
end

Tool:GetPropertyChangedSignal("Enabled"):Connect(UpdateIcon)
Tool.Equipped:connect(OnEquipped)]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX99D73B1CA5174F98927C9749D3A066F9">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="ScriptGuid">{2B490911-1030-47C0-AFB8-1B37498D0695}</string>
				<ProtectedString name="Source"><![CDATA[local GearService = require(1075123174)

local Tool = script.Parent
local Gear = GearService:BindGear(Tool, "Sword")
Gear.Class:SetSlashDamage(20)
Gear.Class:DisableLunge()

Gear:BindEquippedFunction("ChangeAnimation", function()
	if Gear.Humanoid.RigType == Enum.HumanoidRigType.R15 then
		Gear.Class:BindSlashAnimation(Tool.R15Stab)
	else
		Gear.Class:BindSlashAnimation(Tool.Stab)
	end
end)]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
