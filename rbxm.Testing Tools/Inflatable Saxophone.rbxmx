		<Item class="Script" referent="RBX892AA8D930794F1199CDA7A590E2DD3C">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Local Launcher</string>
				<string name="ScriptGuid">{DC59A021-3B06-461F-B8CB-E059B0F8307E}</string>
				<ProtectedString name="Source"><![CDATA[local Rocket = Instance.new("Part")

local Tool = script.Parent

local vel = Instance.new("BodyVelocity")

vel.Parent = Rocket


Rocket.Locked = true

Rocket.Size = Vector3.new(1,1,1)

Rocket.BrickColor = BrickColor.new(24)

Rocket.CanCollide = false



Tool.Note:clone().Parent = Rocket

Tool.RocketScript:clone().Parent = Rocket

--Tool.Explosion:clone().Parent = Rocket

--Tool.Swoosh:clone().Parent = Rocket





function fire(vTarget)



	local vCharacter = Tool.Parent;

	

	local vHandle = Tool:findFirstChild("Handle")

	if vHandle == nil then

		print("Handle not found")

		return 

	end


	local chord = Tool:FindFirstChild("sax" .. tostring(Tool.mode.Value)):clone()
	

	chord.Name = "chord"



	local dir = Vector3.new(math.random()-.5, 1, math.random() - .5).unit



	local missile = Rocket:clone()



	chord.Parent = missile



	local pos = vHandle.Position + Vector3.new(0, 5 ,0)

	

	--missile.Position = pos

	missile.CFrame = CFrame.new(pos,  pos + dir)

	missile.BodyVelocity.velocity = dir * 30

	local vPlayer = game.Players:playerFromCharacter(vCharacter)



	if vPlayer == nil then

		print("Player not found")

	end
	

	missile.RocketScript.Disabled = false


	missile.Parent = game.Workspace

end



Tool.Enabled = true

function onActivated()

	if not Tool.Enabled then

		return

	end



	Tool.Enabled = false



	local character = Tool.Parent;

	local humanoid = character.Humanoid

	if humanoid == nil then

		print("Humanoid not found")

		return 

	end



	local targetPos = humanoid.TargetPoint

	fire(targetPos)



	Tool.Enabled = true

end

script.Parent.Activated:connect(onActivated)



]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX3636626668F840B5A74EFEA9BA35C266">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">RocketScript</string>
				<string name="ScriptGuid">{E391A93A-FEC4-4782-B77D-7F35DECAF87F}</string>
				<ProtectedString name="Source"><![CDATA[shaft = script.Parent




note = script.Parent.chord
note:play()

wait(5)

-- at max range
--script.Parent.Explosion.PlayOnRemove = false
note:stop()
shaft:remove()]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
		<Item class="LocalScript" referent="RBX710C8EBC34E24335B24471037F8185A8">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Local Gui</string>
				<string name="ScriptGuid">{AF9A5BDE-7E02-46D7-87D5-FD23DD295E0F}</string>
				<ProtectedString name="Source"><![CDATA[local Tool = script.Parent;
local anim = nil
enabled = true
local con = nil

function onButton1Down(mouse)
	if not enabled then
		return
	end

	enabled = false

	if anim then
		anim:Play()
	end
	Tool.mode.Value = math.random(1,9)

	enabled = true

end


function onEquippedLocal(mouse)

	if mouse == nil then
		print("Mouse not found")
		return 
	end
	local Humanoid = Tool.Parent:FindFirstChildOfClass("Humanoid")
	if Humanoid then
		if Humanoid.RigType == Enum.HumanoidRigType.R15 then
			anim = Humanoid:LoadAnimation(Tool:WaitForChild("R15Sax"))
		elseif Humanoid.RigType == Enum.HumanoidRigType.R6 then
			anim = Humanoid:LoadAnimation(Tool:WaitForChild("saxtest"))
		end
	end	
	
	mouse.Icon = "http://www.roblox.com/asset/?id=1088199"
	con = mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

function onUnequippedLocal()

	if anim ~= nil then
		anim:Stop()
		anim:Destroy()
	end
	if con ~= nil then
		con:disconnect()
	end

end

Tool.Unequipped:connect(onUnequippedLocal)
Tool.Equipped:connect(onEquippedLocal)
]]></ProtectedString>
