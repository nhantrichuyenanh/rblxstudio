		<Item class="LocalScript" referent="RBXD7C753A1851047BAB2473FB482E22E01">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Local Gui</string>
				<string name="ScriptGuid">{E1CC3C97-F97B-4FD6-8D3F-26D05A08242C}</string>
				<ProtectedString name="Source"><![CDATA[--By QuantumSama
Tool = script.Parent

local checkConnection
local userMouse

function CheckEnabled()
	if userMouse ~= nil then
		if Tool.Enabled then
			userMouse.Icon = "rbxasset://textures\\GunCursor.png"
		else
			userMouse.Icon = "rbxasset://textures\\GunWaitCursor.png"
		end
	end
end

function onEquippedLocal(mouse)
	if mouse == nil then 
		print("Mouse not found")
		return
	end
	userMouse = mouse
	checkConnection = Tool.Changed:connect( CheckEnabled )
end


function onUnequippedLocal()
	if checkConnection then checkConnection:disconnect() end
end

Tool.Equipped:connect(onEquippedLocal)
Tool.Unequipped:connect(onUnequippedLocal)]]></ProtectedString>
