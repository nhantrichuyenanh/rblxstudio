		<Item class="Script" referent="RBXC7F395C02AB547AEB86C86438922805D">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="ScriptGuid">{F3782B05-DEFF-4619-828F-DA8FE21EAB35}</string>
				<ProtectedString name="Source"><![CDATA[local SPEED_INCREASE = 12

local Tool = script.Parent
local Handle = Tool:WaitForChild('Handle')
local MyCharacter = nil
local MyHumanoid = nil

function OnEquipped(mouse)
	if not MyCharacter and not MyHumanoid then
		MyCharacter = Tool.Parent
		MyHumanoid = MyCharacter and MyCharacter:FindFirstChild('Humanoid')
		if MyHumanoid then
			MyHumanoid.WalkSpeed = MyHumanoid.WalkSpeed + SPEED_INCREASE
		end
	end
end

function OnUnequipped()
	if MyHumanoid then
		MyHumanoid.WalkSpeed = MyHumanoid.WalkSpeed - SPEED_INCREASE
	end
	MyCharacter = nil
	MyHumanoid = nil
end


Tool.Equipped:connect(OnEquipped)
Tool.Unequipped:connect(OnUnequipped)
]]></ProtectedString>
