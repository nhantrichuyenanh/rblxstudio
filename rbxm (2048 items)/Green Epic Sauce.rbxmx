		<Item class="LocalScript" referent="RBXDF19E78534B143A899C409ED488F28BC">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Local Gui</string>
				<string name="ScriptGuid">{D9C851C4-A06F-4436-BB3F-3150F876C6AD}</string>
				<ProtectedString name="Source"><![CDATA[local Tool = script.Parent;
local myMouse = nil


enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end
	print("ending")
	enabled = false

	while Tool.Enabled do
		wait(.01)
	end

	print("Setting Mouse To Wait")
	if myMouse ~= nil then myMouse.Icon = "rbxasset://textures\\GunWaitCursor.png" end

	while not Tool.Enabled do
		wait(.01)
	end

	print("Setting Mouse to Go")
	if myMouse ~= nil then myMouse.Icon = "rbxasset://textures\\GunCursor.png" end

	enabled = true
end

function onEquippedLocal(mouse)

	if mouse == nil then
		print("Mouse not found")
		return 
	end

	myMouse = mouse

	if Tool.Enabled then mouse.Icon = "rbxasset://textures\\GunCursor.png"
	else mouse.Icon = "rbxasset://textures\\GunWaitCursor.png" end
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end


Tool.Equipped:connect(onEquippedLocal)
]]></ProtectedString>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX7B1398566BEE44CD9EC9D873063B2B3C">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="ScriptGuid">{E6F05510-7E0F-42A3-8E83-1DCC3A77C7EF}</string>
				<ProtectedString name="Source"><![CDATA[local Tool = script.Parent

Tool.Enabled = true
function onActivated()
	if not Tool.Enabled then return end
      Tool.Enabled = false

	vCharacter = Tool.Parent
	humanoid = vCharacter:FindFirstChild("Humanoid")
	local torso = vCharacter:FindFirstChild("Torso") or vCharacter:FindFirstChild("UpperTorso")
	if humanoid == nil then Tool.Enabled = true return end
	if vCharacter.Name == "BackPack" then Tool.Enabled = true return end

 -- play sound
	magicSound = Tool.Handle:FindFirstChild("MagicSound")
	if magicSound == nil then return end
	magicSound:Play()

-- rest of script
	Tool.Handle.Transparency = 1
	newBV = Instance.new("BodyVelocity")
	newBV.velocity = 40*vCharacter.HumanoidRootPart.CFrame:vectorToWorldSpace(Vector3.new(0,0,-1)).unit
	newBV.maxForce = Vector3.new(100000, 0, 100000)
	newBV.Parent = torso

	newFire = Instance.new("Fire")
	newFire.Color = Color3.new(0,1,0)
	newFire.SecondaryColor = Color3.new(1,1,0)
	newFire.Parent = vCharacter.HumanoidRootPart

	for i = 0,9 do
		humanoid.Jump = true
		newBV.velocity = 40*vCharacter.HumanoidRootPart.CFrame:vectorToWorldSpace(Vector3.new(0,0,-1)).unit
		wait(.5)
	end

	magicSound = Tool.Handle:FindFirstChild("MagicSound")
	if magicSound ~= nil then magicSound:Play() end

	for i = 0,9 do
		humanoid.Jump = true
		newBV.velocity = 40*vCharacter.HumanoidRootPart.CFrame:vectorToWorldSpace(Vector3.new(0,0,-1)).unit
		wait(.5)
	end

	newFire.Parent = nil
	newBV.Parent = nil

	Tool.Handle.Transparency = 0

	Tool.Enabled = true
end

function onEquipped()
	magicSound = Tool.Handle:FindFirstChild("MagicSound")
	if magicSound == nil then
		magicSound = Instance.new("Sound")
		magicSound.Parent = Tool.Handle
		magicSound.Volume = 1
		--magicSound.SoundId = "http://www.roblox.com/asset/?id=35571070"
		magicSound.SoundId = "http://www.roblox.com/asset/?id=35895627" --35895627, --35895661, --10722059
		magicSound.Name = "MagicSound"
	end
end


function onUnequipped()
	magicSound = Tool.Handle:FindFirstChild("MagicSound")
	if magicSound ~= nil then
		magicSound:Stop()
		magicSound.Parent = nil
	end
end

Tool.Activated:connect(onActivated)
Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)
]]></ProtectedString>
