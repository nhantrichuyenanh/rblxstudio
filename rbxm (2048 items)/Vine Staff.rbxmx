		</Item>
		<Item class="Animation" referent="RBXFFB86D7E58BE48F9B32D7B1F0402BDCB">
			<Properties>
				<Content name="AnimationId"><url>http://www.roblox.com/Asset?ID=27432691</url></Content>
				<string name="Name">StaffUp</string>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
		<Item class="LocalScript" referent="RBX596C492E4BE84B80A2922E53F448AD24">
